# Node Configuration
PORT=3001
PEER=http://localhost:3002

# Data File
DATA_FILE=data/blockchain.db

# Environment
NODE_ENV=development

# Proof-of-work difficulty (leading hex zeros required in block hash)
# Use 1-2 for local development; higher values take longer to mine
DIFFICULTY=2

# Environment Configuration
# ---------------------------------------------------------
# NODE_ENV: Switch to "production" for production features
#   - Enables health/metrics endpoints
#   - Enables rate limiting
#   - Disables WebSocket console output (logs to file only)
#   - Changes log level defaults
# ---------------------------------------------------------
NODE_ENV=development

# LOG_LEVEL: Logging level for file and console outputs
#   - error: Only errors written to logs/
#   - warn: Warnings and errors
#   - info: Info, warnings, and errors (default)
#   - debug: Debug, info, warnings, and errors (verbose)
# ---------------------------------------------------------
LOG_LEVEL=info

# LOG_DIR: Directory where log files are written
#   - Logs are rotated at 5MB, keeping the last 5 files
# ---------------------------------------------------------
LOG_DIR=logs

# API Configuration
# ---------------------------------------------------------
# ENABLE_WS: Enable WebSocket real-time update server
#   - true: WebSocket server listens on /ws endpoint
#   - false: WebSocket disabled (saves resources)
# ---------------------------------------------------------
ENABLE_WS=true

# ENABLE_RATE_LIMIT: Enable API rate limiting per IP
#   - true: Rate limiter active (100 requests/15min default)
#   - false: Rate limiting disabled
# ---------------------------------------------------------
ENABLE_RATE_LIMIT=true

# CORS_ORIGINS: Comma-separated list of allowed CORS origins
#   - "*": Allow all origins (default, for development)
#   - Specific origins: "http://localhost:3000,http://localhost:3001"
# ---------------------------------------------------------
CORS_ORIGINS=*

# MAX_BODY_SIZE: Maximum request body size in bytes
#   - 1048576 = 1MB (default)
#   - Increase for larger transaction/block submissions
# ---------------------------------------------------------
MAX_BODY_SIZE=1048576

# Proof-of-work Configuration
# ---------------------------------------------------------
# DIFFICULTY: Initial PoW difficulty (leading zeros in block hashes)
#   - Must match across all peers on the same network
#   - 1-2: Local development (fast block generation)
#   - 3+: Testnet/mainnet (slower, more secure)
#   - Change requires fresh blockchain (new DATA_FILE)
# ---------------------------------------------------------
DIFFICULTY=2

# Target block time in milliseconds
# ---------------------------------------------------------
# TARGET_BLOCK_TIME_MS: How often a block should be mined (default: 60000 = 60s)
#   - Lower = faster blocks, more difficulty adjustments
#   - Higher = slower blocks, smoother difficulty changes
# ---------------------------------------------------------
# (handled internally - do not set manually unless modifying protocol)

# Network Configuration
# ---------------------------------------------------------
# PEER: Comma-separated peer URLs to connect to on startup
#   - Format: http://ip:port or https://ip:port
#   - Example: PEER=http://localhost:3001,http://192.168.1.50:3002
#   - Leave empty to start with no peers (add later via API)
# ---------------------------------------------------------
PEER=http://localhost:3002

# Data File Configuration
# ---------------------------------------------------------
# DATA_FILE: Path to SQLite database file for chain persistence
#   - Must be a relative path from project root
#   - Each node in a network should use a different DATA_FILE
#   - Example: DATA_FILE=data/node1.db, DATA_FILE=data/node2.db
#   - IMPORTANT: Do not run two processes on the same DATA_FILE
# ---------------------------------------------------------
DATA_FILE=data/blockchain.db

# Additional Node Settings
# ---------------------------------------------------------
# PORT: HTTP port the node listens on
# ---------------------------------------------------------
PORT=3001

# Chain ID for network isolation
# ---------------------------------------------------------
# CHAIN_ID: Unique identifier for the network
#   - Prevents cross-network transaction replay
#   - Must match across all peers on the same network
#   - 13371337: Default testnet value
#   - Custom: Use a unique number for your network
# ---------------------------------------------------------
# (handled internally via types.ts - do not set via .env unless customizing)